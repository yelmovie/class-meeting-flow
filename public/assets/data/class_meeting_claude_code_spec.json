  "recommendedTechStack": {
    "framework": "React + Vite + TypeScript",
    "styling": "CSS Modules or plain CSS with CSS variables",
    "state": "React Context + useReducer",
    "storage": "localStorage",
    "routing": "React Router or simple internal step router",
    "pdf": "window.print with print-specific CSS",
    "imageExport": "optional html2canvas; do not require backend",
    "sound": "optional Web Audio or static mp3 assets; must have mute toggle"
  },
  "navigationModel": {
    "screenCount": "메인 랜딩 1장 + 실제 회의 흐름 10장",
    "mainLanding": "page_00_main_landing",
    "flowPages": [
      "page_01_meeting_prepare",
      "page_02_flow_setup",
      "page_03_start_guide",
      "page_04_reflection",
      "page_05_opinion_board",
      "page_06_opinion_summary",
      "page_07_discussion",
      "page_08_vote",
      "page_09_decision",
      "page_10_report"
    ],
    "defaultFlow": [
      "page_00_main_landing",
      "page_01_meeting_prepare",
      "page_02_flow_setup",
      "page_03_start_guide",
      "page_04_reflection",
      "page_05_opinion_board",
      "page_06_opinion_summary",
      "page_07_discussion",
      "page_08_vote",
      "page_09_decision",
      "page_10_report"
    ],
    "progressStepLabelsDefault": [
      "시작",
      "실천 반성",
      "의견 게시",
      "의견 모아보기",
      "토론",
      "결과 공유"
    ],
    "progressStepLabelsCustomizable": true
  },
  "gameFlow": {
    "concept": "회의를 게임처럼 과하게 만들지 않고, 단계 완료와 참여를 귀엽게 보상하는 진행형 플로우",
    "mechanics": [
      {
        "name": "단계 완료 별",
        "description": "각 화면을 완료하면 상단 진행바에 별/체크가 채워진다.",
        "implementation": "CSS class .completed 적용"
      },
      {
        "name": "타이머 긴장감",
        "description": "각 단계별 남은 시간을 시각적으로 표시하고 1분 남으면 부드럽게 알림.",
        "implementation": "useTimer hook + CSS pulse animation"
      },
      {
        "name": "거수 카운트",
        "description": "아이들이 실제로 손을 들고, 진행자가 수를 입력한다.",
        "implementation": "HandRaiseCounter component"
      },
      {
        "name": "의견 공감",
        "description": "좋은 의견에 하트를 누르거나 수동 입력해 공감 수를 모은다.",
        "implementation": "OpinionCard likes state"
      },
      {
        "name": "결정 도장",
        "description": "결정사항 정리 단계에서 완료 도장 애니메이션을 보여준다.",
        "implementation": "CSS scale-in animation"
      },
      {
        "name": "회의록 완성 축하",
        "description": "마지막 페이지에서 회의록이 완성되면 축하 스티커와 confetti animation을 보여준다.",
        "implementation": "CSS confetti or decorative PNG"
      }
    ],
    "stageRewards": {
      "reflection": "지난 약속 돌아보기 완료 배지",
      "opinion": "의견 모으기 완료 배지",
      "summary": "토론 주제 선정 완료 배지",
      "discussion": "서로 존중 토론 완료 배지",
      "vote": "우리 반 선택 완료 배지",
      "decision": "실천 약속 완성 배지",
      "report": "회의록 완성 배지"
    }
  },
  "stateModel": {
    "typescriptInterfaces": "\ntype PageId =\n  | 'page_00_main_landing'\n  | 'page_01_meeting_prepare'\n  | 'page_02_flow_setup'\n  | 'page_03_start_guide'\n  | 'page_04_reflection'\n  | 'page_05_opinion_board'\n  | 'page_06_opinion_summary'\n  | 'page_07_discussion'\n  | 'page_08_vote'\n  | 'page_09_decision'\n  | 'page_10_report';\n\ninterface MeetingState {\n  currentPage: PageId;\n  totalStudents: number;\n  title: string;\n  date: string;\n  roles: {\n    host: string;\n    recorder: string;\n    encourager: string;\n    teacher: string;\n  };\n  customText: {\n    mainTitle: string;\n    agendaLabel: string;\n    reflectionLabel: string;\n    reflectionQuestion: string;\n    opinionGuide: string;\n    summaryLabel: string;\n    discussionQuestion: string;\n    voteQuestion: string;\n    decisionLabel: string;\n    reportTitle: string;\n    teacherCommentLabel: string;\n  };\n  flow: {\n    stepLabels: string[];\n    durationMinutes: number;\n    stageDurations: Record<string, number>;\n    completedPages: PageId[];\n  };\n  previous: {\n    promise: string;\n    summary: string;\n    handRaise: {\n      good: number;\n      normal: number;\n      hard: number;\n    };\n    goodComment: string;\n    hardComment: string;\n  };\n  agenda: {\n    title: string;\n    description: string;\n    selectedTopic: string;\n  };\n  opinions: Opinion[];\n  topicSelection: {\n    candidates: TopicCandidate[];\n    selectedTopic: string;\n  };\n  discussion: {\n    proposal: string;\n    question: string;\n    agreeReason: string;\n    worryPoint: string;\n    handRaise: {\n      presenters: number;\n      questions: number;\n      agreeSpeakers: number;\n      worrySpeakers: number;\n    };\n  };\n  vote: {\n    mode: 'button' | 'handRaise' | 'manual';\n    agree: number;\n    disagree: number;\n    hold: number;\n  };\n  decision: {\n    text: string;\n    practiceMethod: string;\n    owner: string;\n    period: string;\n    nextReview: string;\n    volunteerHands: number;\n  };\n  teacherComment: string;\n}\n\ninterface Opinion {\n  id: string;\n  text: string;\n  reason: string;\n  category: string;\n  likes: number;\n}\n\ninterface TopicCandidate {\n  id: string;\n  label: string;\n  hands: number;\n}\n",
    "localStorageKey": "class-meeting-flow-state-v1",
    "resetStrategy": "새 회의 시작 시 초기값으로 리셋하되, 사용자가 확인해야 한다.",
    "autosave": "각 입력 변경 및 페이지 이동 시 localStorage에 저장"
  },
  "reusableComponents": [
    {
      "name": "PageShell",
      "purpose": "공통 배경, 상단 제목, 진행바, 콘텐츠 영역을 제공",
      "props": [
        "pageId",
        "title",
        "backgroundAsset",
        "children"
      ]
    },
    {
      "name": "ProgressStepper",
      "purpose": "6단계 회의 흐름 표시. 단계명은 수정 가능.",
      "props": [
        "stepLabels",
        "currentStep",
        "completedSteps"
      ]
    },
    {
      "name": "TimerPanel",
      "purpose": "전체 30분 타이머와 단계별 타이머 제공",
      "props": [
        "duration",
        "isRunning",
        "onStart",
        "onPause",
        "onExtend"
      ]
    },
    {
      "name": "HandRaiseCounter",
      "purpose": "거수 수 입력. +, -, 직접 입력, 총원 초과 방지.",
      "props": [
        "label",
        "value",
        "max",
        "onChange"
      ]
    },
    {
      "name": "EditableTextField",
      "purpose": "학급 상황에 맞는 제목, 안건, 질문, 단계명 입력",
      "props": [
        "label",
        "value",
        "placeholder",
        "onChange"
      ]
    },
    {
      "name": "OpinionCard",
      "purpose": "의견, 이유, 카테고리, 공감 수 표시",
      "props": [
        "opinion",
        "onLike",
        "onDelete"
      ]
    },
    {
      "name": "CssButton",
      "purpose": "이미지 없이 CSS로 만드는 주요 버튼",
      "props": [
        "variant",
        "size",
        "children",
        "onClick"
      ]
    },
    {
      "name": "ReportSection",
      "purpose": "회의록 섹션 블록",
      "props": [
        "icon",
        "label",
        "children"
      ]
    },
    {
      "name": "ExportControls",
      "purpose": "PDF 저장, 이미지 저장, 처음으로 이동",
      "props": [
        "onPrint",
        "onImageSave",
        "onHome"
      ]
    }
  ],
  "validationRules": {
    "totalStudents": {
      "min": 1,
      "max": 40,
      "default": 25
    },
    "handRaiseCounters": [
      "각 거수 숫자는 0 이상이어야 한다.",
      "반성 3개 항목 합은 totalStudents를 넘지 않는 것을 권장한다.",
      "투표 3개 항목 합은 totalStudents를 넘으면 경고를 표시한다.",
      "토론 거수 항목은 중복 손들기가 가능하므로 totalStudents 초과를 강제 차단하지 않는다."
    ],
    "requiredFields": [
      "회의 제목",
      "학급 인원",
      "오늘의 안건",
      "지난 회의 약속",
      "투표 질문"
    ],
    "fallbacks": {
      "emptyMeetingTitle": "오늘의 학급회의",
      "emptyAgenda": "우리 반 생활을 더 좋게 만드는 방법",
      "emptyPreviousPromise": "지난 회의에서 정한 약속",
      "emptyTeacherComment": "서로의 의견을 존중하며 잘 참여했어요."
    }
  },
