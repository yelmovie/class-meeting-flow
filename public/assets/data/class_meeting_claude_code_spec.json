      "noSpriteSheet": true,
      "eachAssetMustBeSeparatePng": true,
      "uiButtonsMadeWithCSS": true,
      "inputFieldsMadeWithCSS": true,
      "animationsMadeWithCSS": true,
      "doNotDuplicateAssetsAcrossPages": true,
      "avoidTextInsideImages": true,
      "useTransparentPngForCharactersAndIcons": true,
      "backgroundCanBeFullCanvasPng": true
    }
