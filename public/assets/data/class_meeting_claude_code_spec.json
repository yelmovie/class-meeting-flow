{
  "schemaVersion": "1.0.0",
  "documentName": "class_meeting_webapp_claude_code_spec",
  "language": "ko-KR",
  "project": {
    "name": "학급회의 시간",
    "englishName": "Class Meeting Flow",
    "oneLineDescription": "초등학생 학급회의를 화면 흐름, 타이머, 거수 입력, 투표 수합, 회의록 공유까지 따라 진행하게 하는 프론트엔드 전용 웹앱",
    "targetUsers": [
      "초등학생",
      "학급회장",
      "기록자",
      "격려자",
      "담임교사"
    ],
    "productType": "frontend-only responsive web app",
    "primaryDeviceTargets": [
      "desktop web 1440x1024",
      "tablet landscape 1194x834",
      "tablet portrait 834x1194"
    ],
    "corePrinciple": "아이들이 화면 순서를 따라가면 실제 30분 학급회의가 진행되어야 한다."
  },
  "prd": {
    "problem": {
      "summary": "학급회의가 길어지고, 일부 학생만 참여하며, 지난 회의 결정사항이 실천으로 이어지지 않는 문제를 해결한다.",
      "painPoints": [
        "회의 시간이 흐트러져 30분 안에 결론이 나지 않음",
        "지난 회의에서 정한 약속을 다시 확인하지 않음",
        "의견 게시와 찬반 수합이 구두로만 이루어져 기록이 남지 않음",
        "손들기 결과를 기록하기 어렵고 회의록에 자동 반영되지 않음",
        "회의장, 기록자, 담임이 모두 같은 흐름을 공유하기 어려움"
      ]
    },
    "goal": {
      "primary": "30분 안에 지난 회의 실천 반성, 의견 게시, 의견 모아보기, 토론, 거수/투표 수합, 결정사항 정리, 회의록 공유까지 완료한다.",
      "secondary": [
        "초등학생이 이해하기 쉬운 귀여운 UI를 제공한다.",
        "학급 상황에 따라 안건, 반성 질문, 투표 질문, 단계 문구를 직접 입력할 수 있게 한다.",
        "백엔드 없이 localStorage로 회의 데이터를 보존한다.",
        "거수 입력을 여러 단계에 넣어 실제 교실 진행에 맞춘다."
      ]
    },
    "mvpScope": {
      "included": [
        "메인 랜딩 화면",
        "회의 준비 입력",
        "회의 흐름 설정",
        "회의 시작 안내",
        "지난 회의 실천 반성",
        "의견 게시판",
        "의견 모아보기",
        "토론 진행과 거수 입력",
        "투표하기와 거수 수합",
        "결정사항 정리",
        "결과 공유 / 회의록",
        "localStorage 자동 저장",
        "단계별 타이머",
        "거수 입력 컴포넌트",
        "PDF 저장은 window.print 우선",
        "이미지 저장은 선택 구현"
      ],
      "excluded": [
        "회원가입 / 로그인",
        "실시간 다중 접속",
        "서버 DB",
        "QR 회의방 입장",
        "소켓 통신",
        "교사용 관리자 백엔드",
        "학생별 개인 투표 기록 저장"
      ]
    },
    "successMetrics": [
      {
        "metric": "회의 흐름 완료율",
        "target": "90% 이상이 결과 공유 페이지까지 도달"
      },
      {
        "metric": "30분 내 회의 완료율",
        "target": "80% 이상"
      },
      {
        "metric": "의견 입력 수",
        "target": "한 회의당 3개 이상"
      },
      {
        "metric": "거수/투표 기록 반영률",
        "target": "회의록에 100% 자동 반영"
      },
      {
        "metric": "태블릿 사용성",
        "target": "주요 터치 영역 48px 이상"
      }
    ]
  },
